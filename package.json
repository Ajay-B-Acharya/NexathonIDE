{
  "name": "collaborative-ide",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "tsx src/server/index.ts",
    "dev:collab": "tsx collaboration-backend/server.ts",
    "dev:split": "powershell -ExecutionPolicy Bypass -File ./start-services.ps1",
    "server:yjs": "tsx collaboration-backend/server.ts",
    "server:api": "tsx src/server/api-server.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:init": "tsx src/server/init-db.ts",
    "stop:all": "powershell -Command \"Get-Process node,tsx -ErrorAction SilentlyContinue | Where-Object { $_.Id -ne $PID } | Stop-Process -Force -ErrorAction SilentlyContinue\"",
    "test:collab": "tsx collaboration-backend/test/collaboration.test.ts",
    "test:cross-device": "tsx collaboration-backend/test/cross-device.test.ts",
    "test:conflict": "tsx test/file-conflict.test.ts",
    "test:ai": "tsx --test test/aiProviders.test.ts",
    "start": "tsx src/server/api-server.ts",
    "server:all": "tsx src/server/api-server.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.0.9",
    "@xterm/addon-attach": "^0.12.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "framer-motion": "^14.6.0",
    "groq-sdk": "^1.6.0",
    "lucide-react": "^1.61.0",
    "monaco-editor": "^0.52.2",
    "motion": "^14.6.0",
    "node-pty": "^1.1.0",
    "openai": "^7.43.0",
    "pg": "^8.23.1",
    "pyodide": "^314.0.7",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.0.9",
    "uuid": "^14.0.3",
    "ws": "^8.22.0",
    "y-monaco": "^0.1.6",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33",
    "zustand": "^5.0.16",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
